SELECT * FROM categorias;

SELECT c.nome AS categoria,
       SUM(t.valor) AS total_gasto
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1
  AND c.tipo = 'despesa'
  AND t.data_transacao BETWEEN '2024-08-01' AND '2024-08-31'
GROUP BY c.nome
ORDER BY total_gasto DESC;

SELECT c.tipo,
       SUM(t.valor) AS total
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1
  AND t.data_transacao BETWEEN '2024-08-01' AND '2024-08-31'
GROUP BY c.tipo;

SELECT YEAR(t.data_transacao) AS ano,
       MONTH(t.data_transacao) AS mes,
       SUM(t.valor) AS total_gasto
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1
  AND c.tipo = 'despesa'
GROUP BY YEAR(t.data_transacao), MONTH(t.data_transacao)
ORDER BY ano, mes;

SELECT YEAR(t.data_transacao) AS ano,
       MONTH(t.data_transacao) AS mes,
       SUM(t.valor) AS total_alimentacao
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1
  AND c.nome = 'Alimentação'
GROUP BY YEAR(t.data_transacao), MONTH(t.data_transacao)
ORDER BY ano, mes;

SELECT c.nome AS categoria,
       COUNT(*) AS quantidade,
       SUM(t.valor) AS total
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1
  AND c.tipo = 'despesa'
GROUP BY c.nome
HAVING COUNT(*) >= 2
ORDER BY quantidade DESC;

SELECT DAYOFWEEK(t.data_transacao) AS dia_da_semana,
       SUM(t.valor) AS total_gasto
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1
  AND c.tipo = 'despesa'
GROUP BY DAYOFWEEK(t.data_transacao)
ORDER BY dia_da_semana;

SELECT SUM(CASE WHEN c.tipo = 'receita' THEN t.valor ELSE -t.valor END) AS saldo
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1;

SELECT titulo,
       valor_atual,
       valor_alvo,
       ROUND(valor_atual / valor_alvo * 100) AS porcentagem
FROM metas
WHERE usuario_id = 1;


SELECT t.data_transacao AS dia,
       SUM(t.valor) AS total_gasto
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1
  AND c.tipo = 'despesa'
  AND t.data_transacao BETWEEN '2024-08-21' AND '2024-08-27'
GROUP BY t.data_transacao
ORDER BY dia;


SELECT YEAR(t.data_transacao) AS ano,
       MONTH(t.data_transacao) AS mes,
       c.nome AS categoria,
       SUM(t.valor) AS total_gasto
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1
  AND c.tipo = 'despesa'
  AND t.data_transacao BETWEEN '2024-07-01' AND '2024-08-31'
GROUP BY YEAR(t.data_transacao), MONTH(t.data_transacao), c.nome
ORDER BY categoria, ano, mes;


SELECT t.descricao,
       t.valor,
       COUNT(*) AS quantidade
FROM transacoes t
JOIN categorias c ON c.id_categoria = t.categoria_id
WHERE t.usuario_id = 1
  AND c.tipo = 'despesa'
GROUP BY t.descricao, t.valor
HAVING COUNT(*) >= 2
ORDER BY t.valor DESC;
